{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/atikulislamshadin96/crypto-research-signal-system/blob/main/strategy_discovery_v1/second_collection_v1/schemas/extraction_evidence_bundle.schema.json",
  "title": "Deterministic rule extraction evidence bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "extraction_version",
    "analysis_only",
    "source_identity",
    "snapshot",
    "field_claims",
    "promotion_decision",
    "reconstruction_performed"
  ],
  "properties": {
    "extraction_version": {"const": "deterministic_rule_extraction_v1_poc"},
    "analysis_only": {"const": true},
    "source_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "source_id", "source_class", "canonical_url"],
      "properties": {
        "document_id": {"type": "string", "minLength": 1},
        "source_id": {"type": "string", "minLength": 1},
        "source_class": {"type": "string", "minLength": 1},
        "canonical_url": {"type": "string", "format": "uri"},
        "document_version": {"type": "string"}
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_type", "content_sha256", "byte_size", "retrieved_at", "adapter_id"],
      "properties": {
        "content_type": {"enum": ["application/pdf", "text/plain", "text/html", "application/json", "unknown"]},
        "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "byte_size": {"type": "integer", "minimum": 1},
        "retrieved_at": {"type": "string", "format": "date-time"},
        "adapter_id": {"enum": ["arxiv_pdf_v1", "quantconnect_code_v1", "published_html_v1", "notebook_v1", "social_video_lead_v1"]},
        "source_snapshot_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "field_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field_path", "status", "evidence", "extraction_method", "ambiguity_flags"],
        "properties": {
          "field_path": {"type": "string", "minLength": 1},
          "status": {"enum": ["explicit", "explicit_but_ambiguous", "not_found", "contradictory"]},
          "value": {},
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source_url", "snapshot_sha256", "locator_type", "locator", "verbatim"],
              "properties": {
                "source_url": {"type": "string", "format": "uri"},
                "snapshot_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
                "locator_type": {"enum": ["pdf_page_chars", "html_dom_chars", "code_lines", "notebook_cell"]},
                "locator": {"type": "string", "minLength": 1},
                "verbatim": {"type": "string", "minLength": 1, "maxLength": 2000}
              }
            }
          },
          "extraction_method": {"enum": ["deterministic_pattern", "ast_control_flow", "structured_table", "manual_review_required"]},
          "ambiguity_flags": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "promotion_decision": {"enum": ["candidate_complete", "needs_review", "rejected_incomplete", "rejected_contradictory"]},
    "reconstruction_performed": {"const": false},
    "normalized_candidate": {"type": "object"},
    "review_reasons": {"type": "array", "items": {"type": "string"}}
  }
}
